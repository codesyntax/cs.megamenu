<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.megamenu"
    >

  <genericsetup:registerProfile
      name="default"
      title="collective.megamenu: Install"
      description="Package to configure a new collective.megamenu site"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".setuphandlers.add_behavior_to_lrf"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="collective.megamenu: Uninstall"
      description="Uninstall collective.megamenu setup."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="collective.megamenu"
      />


  <include package=".upgrades" />

</configure>
