#: collective/megamenu/widgets/menu.py:63
msgid " (required)"
msgstr " (derrigorrezkoa)"

#: collective/megamenu/widgets/menu.py:86
msgid "(untitled)"
msgstr "(izenbururik gabe)"

#: collective/megamenu/widgets/menu.py:43
msgid "+ Folder"
msgstr "+ Karpeta"

#: collective/megamenu/widgets/menu.py:44
msgid "+ Link"
msgstr "+ Esteka"

#: collective/megamenu/behaviors/configure.zcml:17
msgid "A configurable JSON-backed menu."
msgstr "JSON-en oinarritutako menu konfiguragarria."

#: collective/megamenu/validators/validation.py:48
#: collective/megamenu/widgets/menu.py:113
msgid "A folder cannot have a target."
msgstr "Karpeta batek ezin du helbururik izan."

#: collective/megamenu/widgets/menu.py:114
msgid "A folder must have children."
msgstr "Karpeta batek elementu seme-alabak izan behar ditu."

#: collective/megamenu/validators/validation.py:49
#: collective/megamenu/widgets/menu.py:115
msgid "A link cannot have children."
msgstr "Esteka batek ezin ditu elementu seme-alabak izan."

#: collective/megamenu/validators/validation.py:51
#: collective/megamenu/widgets/menu.py:117
msgid "A menu item must be a folder or a link."
msgstr "Menu-elementua karpeta edo esteka bat izan behar da."

#: collective/megamenu/widgets/menu.py:53
msgid "Add folder"
msgstr "Gehitu karpeta"

#: collective/megamenu/widgets/menu.py:83
msgid "Add folder inside"
msgstr "Gehitu karpeta barruan"

#: collective/megamenu/widgets/menu.py:54
msgid "Add link"
msgstr "Gehitu esteka"

#: collective/megamenu/widgets/menu.py:84
msgid "Add link inside"
msgstr "Gehitu esteka barruan"

#: collective/megamenu/widgets/menu.py:61
msgid "CSS class"
msgstr "CSS klasea"

#: collective/megamenu/validators/validation.py:50
#: collective/megamenu/widgets/menu.py:116
msgid "Choose exactly one target: internal or external."
msgstr "Aukeratu helburu bat soilik: barnekoa edo kanpokoa."

#: collective/megamenu/widgets/menu.py:81
msgid "Collapse"
msgstr "Tolestu"

#: collective/megamenu/behaviors/menu.py:23
msgid "Custom menu for this folder and its descendants. Leave unset to inherit the nearest ancestor's menu."
msgstr "Karpeta honetarako eta bere ondorengoetarako menu pertsonalizatua. Utzi zehaztu gabe gertueneko arbasoaren menua heredatzeko."

#: collective/megamenu/widgets/menu.py:80
msgid "Delete"
msgstr "Ezabatu"

#: collective/megamenu/widgets/menu.py:94
msgid "Delete \"{title}\" and its {count} direct child item(s)?"
msgstr "Ezabatu \"{title}\" eta bere {count} elementu seme-alaba zuzena(k)?"

#: collective/megamenu/behaviors/configure.zcml:17
msgid "Editable menu"
msgstr "Menu editagarria"

#: collective/megamenu/widgets/menu.py:82
msgid "Expand"
msgstr "Zabaldu"

#: collective/megamenu/widgets/menu.py:75
msgid "External"
msgstr "Kanpokoa"

#: collective/megamenu/widgets/menu.py:76
msgid "External URL"
msgstr "Kanpo URL-a"

#: collective/megamenu/widgets/menu.py:58
msgid "Folder"
msgstr "Karpeta"

#: collective/megamenu/widgets/menu.py:56
msgid "Folder details"
msgstr "Karpetaren xehetasunak"

#: collective/megamenu/widgets/menu.py:67
msgid "Folders are placeholders. They group children and are not clickable."
msgstr "Karpetak leku-markak dira. Seme-alabak biltzen dituzte eta ez dira klikagarriak."

#: collective/megamenu/widgets/menu.py:66
msgid "Icon preview:"
msgstr "Ikonoaren aurrebista:"

#: collective/megamenu/widgets/menu.py:74
msgid "Internal"
msgstr "Barnekoa"

#: collective/megamenu/widgets/menu.py:89
msgid "Internal target"
msgstr "Barne helburua"

#: collective/megamenu/widgets/menu.py:93
msgid "Internal target selected."
msgstr "Barne helburua hautatuta."

#: collective/megamenu/widgets/menu.py:59
msgid "Link"
msgstr "Esteka"

#: collective/megamenu/widgets/menu.py:57
msgid "Link details"
msgstr "Estekaren xehetasunak"

#: collective/megamenu/behaviors/menu.py:17
msgid "Mega menu"
msgstr "Megamenua"

#: collective/megamenu/behaviors/menu.py:22
msgid "Menu"
msgstr "Menua"

#: collective/megamenu/validators/validation.py:47
#: collective/megamenu/widgets/menu.py:112
msgid "Menu item IDs must be unique and valid UUIDs."
msgstr "Menu-elementuen IDek baliozko UUID bakarrak izan behar dituzte."

#: collective/megamenu/widgets/menu.py:42
msgid "Menu tree"
msgstr "Menuaren zuhaitza"

#: collective/megamenu/widgets/menu.py:79
msgid "Move down"
msgstr "Mugitu behera"

#: collective/megamenu/widgets/menu.py:78
msgid "Move up"
msgstr "Mugitu gora"

#: collective/megamenu/widgets/menu.py:46
msgid "No menu configured"
msgstr "Ez dago menurik konfiguratuta"

#: collective/megamenu/widgets/menu.py:50
msgid "No menu is configured here. The nearest ancestor menu is inherited."
msgstr "Hemen ez dago menurik konfiguratuta. Gertueneko arbasoaren menua heredatzen da."

#: collective/megamenu/widgets/menu.py:90
msgid "No target"
msgstr "Helbururik gabe"

#: collective/megamenu/widgets/menu.py:77
msgid "Open in a new tab"
msgstr "Ireki fitxa berri batean"

#: collective/megamenu/profiles.zcml:14
msgid "Package to configure a new collective.megamenu site"
msgstr "collective.megamenu gune berri bat konfiguratzeko paketea"

#: collective/megamenu/widgets/menu.py:62
msgid "Plone icon name"
msgstr "Plone ikonoaren izena"

#: collective/megamenu/widgets/menu.py:55
msgid "Select a menu item to edit it."
msgstr "Hautatu menu-elementu bat editatzeko."

#: collective/megamenu/widgets/menu.py:73
msgid "Target"
msgstr "Helburua"

#: collective/megamenu/widgets/menu.py:48
msgid "The nearest ancestor menu is inherited."
msgstr "Gertueneko arbasoaren menua heredatzen da."

#: collective/megamenu/validators/validation.py:42
#: collective/megamenu/widgets/menu.py:108
msgid "The selected internal target no longer exists or is not visible to you."
msgstr "Hautatutako barne helburua jada ez da existitzen edo ez da ikusgai zuretzat."

#: collective/megamenu/widgets/menu.py:49
msgid "The viewlet will render no navigation here."
msgstr "Viewletak ez du nabigaziorik erakutsiko hemen."

#: collective/megamenu/widgets/menu.py:70
msgid "This folder has no children and will not appear in the menu."
msgstr "Karpeta honek ez du seme-alabarik eta ez da menuan agertuko."

#: collective/megamenu/widgets/menu.py:47
msgid "This menu is intentionally empty"
msgstr "Menu hau nahita dago hutsik"

#: collective/megamenu/widgets/menu.py:60
msgid "Title"
msgstr "Izenburua"

#: collective/megamenu/validators/validation.py:45
#: collective/megamenu/widgets/menu.py:97
msgid "Title is required."
msgstr "Izenburua derrigorrezkoa da."

#: collective/megamenu/profiles.zcml:22
msgid "Uninstall collective.megamenu setup."
msgstr "Desinstalatu collective.megamenu konfigurazioa."

#: collective/megamenu/validators/validation.py:66
msgid "Unknown field: `${name}`."
msgstr "Eremu ezezaguna: `${name}`."

#: collective/megamenu/validators/validation.py:52
#: collective/megamenu/widgets/menu.py:118
msgid "Unsupported menu version. Expected version 1."
msgstr "Onartzen ez den menu-bertsioa. 1. bertsioa espero zen."

#: collective/megamenu/widgets/menu.py:87
msgid "Untitled folder"
msgstr "Izenbururik gabeko karpeta"

#: collective/megamenu/validators/validation.py:191
msgid "Untitled item #{index}"
msgstr "Izenbururik gabeko elementua #{index}"

#: collective/megamenu/widgets/menu.py:88
msgid "Untitled link"
msgstr "Izenbururik gabeko esteka"

#: collective/megamenu/validators/validation.py:39
#: collective/megamenu/widgets/menu.py:103
msgid "Use a valid Plone icon name, for example alarm or contenttype/document."
msgstr "Erabili Plone ikonoaren izen baliozkoa, adibidez alarm edo contenttype/document."

#: collective/megamenu/validators/validation.py:35
#: collective/megamenu/widgets/menu.py:107
msgid "Use an http(s), mailto, or tel URL."
msgstr "Erabili http(s), mailto edo tel URL bat."

#: collective/megamenu/validators/validation.py:46
#: collective/megamenu/widgets/menu.py:98
msgid "Use at most 200 characters."
msgstr "Erabili gehienez 200 karaktere."

#: collective/megamenu/widgets/menu.py:45
msgid "Use inherited menu"
msgstr "Erabili heredatutako menua"

#: collective/megamenu/validators/validation.py:36
#: collective/megamenu/widgets/menu.py:99
msgid "Use only letters, numbers, hyphens, and underscores, separated by single spaces."
msgstr "Erabili soilik letrak, zenbakiak, marratxoak eta azpimarrak, zuriune bakar batez banatuta."

#: collective/megamenu/widgets/menu.py:91
msgid "child"
msgstr "seme-alaba"

#: collective/megamenu/widgets/menu.py:92
msgid "children"
msgstr "seme-alabak"

#: collective/megamenu/profiles.zcml:14
msgid "collective.megamenu: Install"
msgstr "collective.megamenu: Instalatu"

#: collective/megamenu/profiles.zcml:22
msgid "collective.megamenu: Uninstall"
msgstr "collective.megamenu: Desinstalatu"

#: collective/megamenu/widgets/menu.py:65
msgid "e.g. alarm or contenttype/document"
msgstr "adib. alarm edo contenttype/document"

#: collective/megamenu/widgets/menu.py:64
msgid "e.g. nav-products"
msgstr "adib. nav-products"

#: collective/megamenu/widgets/menu.py:85
msgid "{count} validation error(s)"
msgstr "{count} balidazio-errore"
