msgid "The viewlet will render no navigation here."
msgstr "El viewlet no mostrará ninguna navegación aquí."

#: collective/megamenu/browser/widgets.py:70
msgid "This folder has no children and will not appear in the menu."
msgstr "Esta carpeta no tiene elementos hijos y no aparecerá en el menú."

#: collective/megamenu/browser/widgets.py:47
msgid "This menu is intentionally empty"
msgstr "Este menú está vacío intencionadamente"

#: collective/megamenu/browser/widgets.py:60
msgid "Title"
msgstr "Título"

#: collective/megamenu/browser/widgets.py:97
#: collective/megamenu/validation.py:45
msgid "Title is required."
msgstr "El título es obligatorio."

#: collective/megamenu/profiles.zcml:22
msgid "Uninstall collective.megamenu setup."
msgstr "Desinstalar la configuración de collective.megamenu."

#: collective/megamenu/validation.py:66
msgid "Unknown field: `${name}`."
msgstr "Campo desconocido: `${name}`."

#: collective/megamenu/browser/widgets.py:118
#: collective/megamenu/validation.py:52
msgid "Unsupported menu version. Expected version 1."
msgstr "Versión de menú no compatible. Se esperaba la versión 1."

#: collective/megamenu/browser/widgets.py:87
msgid "Untitled folder"
msgstr "Carpeta sin título"

#: collective/megamenu/validation.py:191
msgid "Untitled item #{index}"
msgstr "Elemento sin título #{index}"

#: collective/megamenu/browser/widgets.py:88
msgid "Untitled link"
msgstr "Enlace sin título"

#: collective/megamenu/browser/widgets.py:103
#: collective/megamenu/validation.py:39
msgid "Use a valid Plone icon name, for example alarm or contenttype/document."
msgstr "Usa un nombre de icono de Plone válido, por ejemplo alarm o contenttype/document."

#: collective/megamenu/browser/widgets.py:107
#: collective/megamenu/validation.py:35
msgid "Use an http(s), mailto, or tel URL."
msgstr "Utilice una URL http(s), mailto o tel."

#: collective/megamenu/browser/widgets.py:98
#: collective/megamenu/validation.py:46
msgid "Use at most 200 characters."
msgstr "Utilice como máximo 200 caracteres."

#: collective/megamenu/browser/widgets.py:45
msgid "Use inherited menu"
msgstr "Usar el menú heredado"

#: collective/megamenu/browser/widgets.py:99
#: collective/megamenu/validation.py:36
msgid "Use only letters, numbers, hyphens, and underscores, separated by single spaces."
msgstr "Utilice solo letras, números, guiones y guiones bajos, separados por un solo espacio."

#: collective/megamenu/browser/widgets.py:91
msgid "child"
msgstr "elemento hijo"

#: collective/megamenu/browser/widgets.py:92
msgid "children"
msgstr "elementos hijos"

