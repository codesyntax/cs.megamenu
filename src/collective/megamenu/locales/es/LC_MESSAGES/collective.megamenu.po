#: collective/megamenu/behaviors.zcml:17
msgid "A configurable JSON-backed menu."
msgstr "Un menú configurable basado en JSON."

#: collective/megamenu/browser/widgets.py:113
#: collective/megamenu/validation.py:48
msgid "A folder cannot have a target."
msgstr "Una carpeta no puede tener un destino."

#: collective/megamenu/browser/widgets.py:114
msgid "A folder must have children."
msgstr "Una carpeta debe tener elementos hijos."

#: collective/megamenu/browser/widgets.py:115
#: collective/megamenu/validation.py:49
msgid "A link cannot have children."
msgstr "Un enlace no puede tener elementos hijos."

#: collective/megamenu/browser/widgets.py:117
#: collective/megamenu/validation.py:51
msgid "A menu item must be a folder or a link."
msgstr "Un elemento de menú debe ser una carpeta o un enlace."

