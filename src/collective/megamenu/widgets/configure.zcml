<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:z3c="http://namespaces.zope.org/z3c"
    i18n_domain="collective.megamenu"
    >

  <include
      package="z3c.form"
      file="meta.zcml"
      />

  <!-- Master-detail editor for the JSON-backed menu field. -->
  <z3c:widgetTemplate
      widget=".menu.IMegaMenuWidget"
      template="templates/menu_input.pt"
      layer="collective.megamenu.interfaces.IBrowserLayer"
      mode="input"
      />

</configure>
