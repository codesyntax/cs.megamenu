<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.megamenu"
    >

  <include
      package="plone.behavior"
      file="meta.zcml"
      />

  <plone:behavior
      name="collective.megamenu.menu"
      title="Editable menu"
      description="A configurable JSON-backed menu."
      provides=".menu.IEditableMenu"
      />

</configure>
